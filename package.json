{
  "name": "prana",
  "private": true,
  "version": "1.0.0",
  "description": "PranaCoach — adaptive pranayama breath-timer (POC 1 / R1 desktop MVP)",
  "scripts": {
    "build:core": "pnpm --filter @prana/core build",
    "test": "pnpm --filter @prana/core test",
    "test:core": "pnpm --filter @prana/core test",
    "dev": "pnpm --filter @prana/desktop dev",
    "build:desktop": "pnpm --filter @prana/desktop build",
    "lint": "pnpm -r lint"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "electron", "esbuild"]
  }
}
